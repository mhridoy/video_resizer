{
  "name": "video-resizer",
  "version": "1.2.0",
  "description": "Free video, image and PDF tools by Binary Beat",
  "author": "Binary Beat",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-core.mjs && node scripts/copy-desktop.mjs && vite build",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "5.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "org.binarybear.videoresizer",
    "productName": "Binary Beat",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md",
      "!dist/ffmpeg/**/*",
      "!dist/downloads/**/*",
      "!node_modules/@ffmpeg/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Video-Resizer-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Video-Resizer-Windows-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mhridoy",
        "repo": "video_resizer"
      }
    ]
  }
}
