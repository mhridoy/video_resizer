{
  "name": "video-resizer",
  "version": "1.0.0",
  "description": "Private batch video resizing for Windows, macOS, and the web",
  "author": "Moshiur Rahman",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-core.mjs && vite build",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/core": "0.12.10",
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "org.binarybear.videoresizer",
    "productName": "Video Resizer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Video-Resizer-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "artifactName": "Video-Resizer-macOS-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Video-Resizer-Windows-Portable.${ext}"
    }
  }
}
